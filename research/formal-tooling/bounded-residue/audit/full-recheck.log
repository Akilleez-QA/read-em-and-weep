                                  (ResidueBridge.interpret
                                    [(SelectorLaurentBridge.exponent a0 a1 a2 a3 a4, ca),
                                      (SelectorLaurentBridge.exponent b0 b1 b2 b3 b4, cb)]) :=
fun a0 a1 a2 a3 a4 ca b0 b1 b2 b3 b4 cb ha0 ha1 ha2 ha3 ha4 hca hb0 hb1 hb2 hb3 hb4 hcb hcaBound hcbBound =>
