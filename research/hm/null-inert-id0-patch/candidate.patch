+    def certify_laurent(self, context):
+        """One complete division; retain the quotient, identity and lifetime.
+
+        Frame labels are caller declarations, not source authentication.
+        This pure field API grants no physical execution permission.
+        """
+        self.ex.check()
+        if type(context) is not LaurentContext or context.ex is not self.ex:
+            raise ValueError("foreign Laurent context")
+        d = tuple(min(e[i] for e, _ in self.denominator.terms) for i in range(4))
+        self.ex.tick('storage_events', 5)
+        residual = self.ex.poly((tuple(e[i]-d[i] for i in range(4)), c)
+                                for e, c in self.denominator.terms)
+        quotient, remainder = self.numerator.divide(residual)
+        if not remainder.is_zero():
+            raise NotLaurentPolynomial("nonzero polynomial division remainder")
+        self.ex.check()
+        return LaurentCertificate(_LAURENT_SEAL, self, context, d, quotient)
