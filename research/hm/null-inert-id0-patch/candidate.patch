+_LAURENT_SEAL = object()
+
+
+@dataclass(frozen=True, slots=True, init=False, eq=False)
+class LaurentContext:
+    ex: Execution = field(repr=False)
+    frame: tuple
+
+    def __init__(self, ex, frame):
+        if type(ex) is not Execution:
+            raise TypeError("production Execution required")
+        ex.check()
+        if type(frame) is not tuple or not frame or any(type(v) is not str for v in frame):
+            raise TypeError("immutable nonempty frame tuple required")
+        ex.tick('storage_events', len(frame) + 1)
+        object.__setattr__(self, 'ex', ex)
+        object.__setattr__(self, 'frame', frame)
+
+
+@dataclass(frozen=True, slots=True, init=False, eq=False)
+class LaurentCertificate:
+    rational: Rational = field(repr=False)
+    context: LaurentContext = field(repr=False)
+    ex: Execution = field(repr=False)
+    shift: tuple
+    quotient: Poly = field(repr=False)
+
+    def __init__(self, seal, rational, context, shift, quotient):
+        if seal is not _LAURENT_SEAL:
+            raise TypeError("use Rational.certify_laurent")
+        ex = rational.ex
+        ex.check()
+        if context.ex is not ex or quotient.ex is not ex:
+            raise ValueError("certificate Execution mismatch")
+        ex.tick('storage_events', 6)
+        object.__setattr__(self, 'rational', rational)
+        object.__setattr__(self, 'context', context)
+        object.__setattr__(self, 'ex', ex)
+        object.__setattr__(self, 'shift', shift)
+        object.__setattr__(self, 'quotient', quotient)
+
+    def _check(self, rational, context):
+        self.ex.check()
+        if rational is not self.rational or context is not self.context:
+            raise ValueError("certificate rational/context identity mismatch")
+        if rational.ex is not self.ex or context.ex is not self.ex or self.quotient.ex is not self.ex:
+            raise ValueError("certificate Execution mismatch")
+
+    def coefficient(self, rational, context, exponent):
+        self._check(rational, context)
+        exponent = _exponent(exponent, signed=True)
+        target = tuple(exponent[i] + self.shift[i] for i in range(4))
+        self.ex.tick('storage_events', 5)
+        for power in target:
+            self.ex.observe(Fraction(power))
+        answer = self.ex.q(0)
+        for e, c in self.quotient.terms:
+            self.ex.tick()
+            if e == target:
+                answer = c
+                break
+        self._check(rational, context)
+        return answer
+
+    def weighted_coefficients(self, rational, context, terms):
+        self._check(rational, context)
+        if type(terms) is not tuple:
+            raise TypeError("immutable coefficient request tuple required")
+        answer = self.ex.q(0)
+        for item in terms:
+            self.ex.tick()
+            if type(item) is not tuple or len(item) != 2:
+                raise TypeError("exponent/weight tuple required")
+            exponent, weight = item
+            if type(exponent) is not tuple:
+                raise TypeError("immutable exponent tuple required")
+            weight = self.ex.q(weight)
+            value = self.coefficient(rational, context, exponent)
+            product = self.ex.mul(weight, value)
+            answer = self.ex.add(answer, product)
+            self.ex.tick('storage_events', 3)
+        self._check(rational, context)
+        return answer
 
 
