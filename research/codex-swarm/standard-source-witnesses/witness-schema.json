{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unbound whole-standard actual-source witness proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owners",
    "pair",
    "target_standard_tags",
    "source_sorted_owners",
    "source_sorting_sign",
    "source_order",
    "numerator_scope",
    "numerator_degree",
    "divisor_degrees",
    "extension_scope",
    "obligations",
    "source_faithful_oracle_identity_accepted",
    "physical_execution_authorized",
    "actual_source_evaluated",
    "admitted"
  ],
  "properties": {
    "schema": {
      "const": "whole-standard-source-witness-proposal-v1"
    },
    "source_order": {
      "const": "auxiliary5-first, primary0..4, numeric-low-bit-mask, high-bit-standard-tag"
    },
    "numerator_scope": {
      "const": "whole_actual_F=b-tr(C)/2"
    },
    "extension_scope": {
      "const": "whole_coefficient_on_standard_target"
    },
    "source_faithful_oracle_identity_accepted": {
      "const": false
    },
    "physical_execution_authorized": {
      "const": false
    },
    "actual_source_evaluated": {
      "const": false
    },
    "admitted": {
      "const": false
    },
    "owners": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "$ref": "#/$defs/occurrence"
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        ]
      }
    },
    "source_sorted_owners": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "$ref": "#/$defs/occurrence"
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          }
        ]
      }
    },
    "target_standard_tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      }
    },
    "pair": {
      "enum": [
        [
          0,
          1
        ],
        [
          2,
          3
        ]
      ]
    },
    "source_sorting_sign": {
      "type": "integer",
      "enum": [
        -1,
        1
      ]
    },
    "numerator_degree": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "divisor_degrees": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "obligations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_homogeneous_P_identity",
        "fixed_partition_Qhat_identity",
        "fresh_source_order_and_frame_identity",
        "old_scalar_exactness_and_domain_identity"
      ],
      "properties": {
        "actual_homogeneous_P_identity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "candidate_proof_sha256"
              ],
              "properties": {
                "status": {
                  "const": "unbound"
                },
                "candidate_proof_sha256": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "candidate_proof_sha256"
              ],
              "properties": {
                "status": {
                  "const": "candidate"
                },
                "candidate_proof_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "fixed_partition_Qhat_identity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "candidate_proof_sha256"
              ],
              "properties": {
                "status": {
                  "const": "unbound"
                },
                "candidate_proof_sha256": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "candidate_proof_sha256"
              ],
              "properties": {
                "status": {
                  "const": "candidate"
                },
                "candidate_proof_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "fresh_source_order_and_frame_identity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "candidate_proof_sha256"
              ],
              "properties": {
                "status": {
                  "const": "unbound"
                },
                "candidate_proof_sha256": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "candidate_proof_sha256"
              ],
              "properties": {
                "status": {
                  "const": "candidate"
                },
                "candidate_proof_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "old_scalar_exactness_and_domain_identity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "candidate_proof_sha256"
              ],
              "properties": {
                "status": {
                  "const": "unbound"
                },
                "candidate_proof_sha256": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "candidate_proof_sha256"
              ],
              "properties": {
                "status": {
                  "const": "candidate"
                },
                "candidate_proof_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "occurrence": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        }
      ]
    }
  },
  "$comment": "Cross-field degrees/source sorting/owners require witnesses.validate_proposal. No proof/admission validation is performed."
}
